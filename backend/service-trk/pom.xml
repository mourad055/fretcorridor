<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.fretcorridor</groupId>
    <artifactId>service-trk</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>service-trk</name>
    <description>Suivi temps reel et ETA FretCorridor : ingestion PositionBrute, ecart de trajectoire, alertes</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- common-libs partagé -->
        <dependency>
            <groupId>com.fretcorridor</groupId>
            <artifactId>common-libs</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Premier service du repo a consommer Kafka : ingestion PositionBrute
             (Mobile -> TRK, async, cf regle de communication du perimetre Moteur).
             Version geree par le BOM spring-boot-dependencies (parent 3.3.4) -
             jamais de version explicite ici, pour rester coherent avec le reste
             du stack Spring au moment d'une montee de version groupee. -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Broker Kafka embarque en memoire pour tester le consumer sans
             dependre d'un vrai cluster Kafka - utile des le premier test
             d'idempotence (ENF-SEC-03), a l'etape "ingestion" du plan. -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Meme piege que service-opt/service-mat si on l'oublie : jar sans
                 Main-Class, "no main manifest attribute" au demarrage du conteneur. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
