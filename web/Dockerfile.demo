# Dockerfile.demo — UNIQUEMENT pour test local des comptes demo (image
# separee, ne remplace jamais Dockerfile qui reste la reference prod).
# Difference unique : ng build --configuration development, qui active
# fileReplacements -> environment.development.ts (enableDemoLogin: true).
# Jamais utilise pour un vrai deploiement.

FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npx ng build --configuration development

FROM nginx:1.27-alpine
COPY --from=build /app/dist/web/browser /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
